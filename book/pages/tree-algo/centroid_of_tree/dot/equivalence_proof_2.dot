graph G {
    rankdir=LR;
    node[shape=circle, fixedsize=true, width=0.32, fontsize=14];
    edge[color="#666666", penwidth=1.4];
    fontname="sans-serif";

    subgraph cluster_dir2 {
        label="后证：路径上 f 严格递减，却从 ≤n/2 跨到 >n/2";
        fontsize=14;
        style="rounded,dashed";
        color="#888888";

        p0[width=0.5, fontsize=18, penwidth=2, color="#c62828"];
        p1;
        p2;
        p3;
        p4[width=0.5, fontsize=18, penwidth=2, color="#1565c0"];

        p0 -- p1 [label="f_0"];
        p1 -- p2 [label="f_1"];
        p2 -- p3 [label="⋯"];
        p3 -- p4 [label="f_{k-1}"];
    }
}
