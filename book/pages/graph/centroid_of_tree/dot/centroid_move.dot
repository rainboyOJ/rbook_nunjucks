graph G {
    rankdir=LR;
    node[shape=circle, fixedsize=true, width=0.32, fontsize=14];
    edge[color="#666666", penwidth=1.4];
    fontname="sans-serif";

    subgraph cluster_left {
        label="2 个点";
        fontsize=16;
        style="rounded,dashed";
        color="#888888";
        l1 -- l2;
    }

    u[width=0.5, fontsize=18, penwidth=2, color="#c62828"];

    subgraph cluster_right {
        label="6 个点";
        fontsize=16;
        style="rounded,dashed";
        color="#888888";
        r1 -- r2 -- r3;
        r2 -- r4;
        r4 -- r5;
        r4 -- r6;
    }

    l2 -- u;
    u -- r1;
}
