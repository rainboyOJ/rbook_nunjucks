aside.panel.J_readingToolbar(aria-label="页面工具")
  ul.panel-list
    li
      a(href="/" title="首页" aria-label="首页")
        i.fa.fa-home(aria-hidden="true")
    li
      button.J_bookMenu(type="button" title="全书目录" aria-label="全书目录" aria-controls="modal-menu" aria-expanded="false")
        i.fa.fa-book(aria-hidden="true")
    if printable_article
      li.panel-toc-control
        button.J_tocToggle(type="button" title="本页目录" aria-label="本页目录" aria-controls="article-toc" aria-expanded="false")
          i.fa.fa-list-ul(aria-hidden="true")
    li.panel-more
      button.J_moreToggle(type="button" title="更多" aria-label="更多" aria-controls="reading-more-menu" aria-expanded="false")
        i.fa.fa-ellipsis-h(aria-hidden="true")
      #reading-more-menu.reading-more-menu(hidden)
        fieldset.theme-control
          legend 主题
          label
            input#darkmode-auto.J_darkMode(type="radio" value="auto" name="darkmode" checked="")
            i.fa.fa-adjust(aria-hidden="true")
            span 跟随系统
          label
            input#darkmode-light.J_darkMode(type="radio" value="light" name="darkmode")
            i.fa.fa-sun-o(aria-hidden="true")
            span 浅色
          label
            input#darkmode-dark.J_darkMode(type="radio" value="dark" name="darkmode")
            i.fa.fa-moon-o(aria-hidden="true")
            span 深色
        if printable_article
          button.reading-menu-action.J_printArticle(type="button")
            i.fa.fa-print(aria-hidden="true")
            span 打印文章
