style.
  .app-nav-bar {
      display: flex;
      justify-content: space-around;
      align-items: center;
      background-color: #333;
      padding: 10px 0;
  }

  .app-nav-bar a {
      color: white;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 12px;
  }

  .app-nav-bar a .iconify {
      font-size: 24px;
      margin-bottom: 5px;
  }

  .app-nav-bar a svg {
      font-size: 24px;
      margin-bottom: 5px;
      height: 24px !important;
      width: 24px !important;
  }

