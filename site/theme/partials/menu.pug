mixin renderList(items, parentPath)
  - parentPath = parentPath || ''
  if items
    ul
      each item in items
        - const currentPath = parentPath + item.path
        - const displayTitle = item['english-title'] ? `${item['english-title']} | ${item.title}` : item.title
        li
          if item.type && item.type == "info"
            a.menu-info(href="javascript:void(0);")
              span
                if item.icon
                  span.svg-icon
                    != item.icon
                | #{displayTitle}
          else if item.nolink
            i.fa.fa-folder-open-o
            a.menu-no-link(href="javascript:void(0);")= displayTitle
          else
            if item.id
              button.menu-copy-id.J_copyArticleId(type="button" data-copy-article-id=item.id aria-label=`复制文章 ID：${item.id}` title="复制文章 ID")
                i.fa.fa-file-text(aria-hidden="true")
                span.article-copy-feedback(aria-live="polite" aria-atomic="true")
            else
              i.fa.fa-file-text(aria-hidden="true")
            a(href=menuLink(currentPath))= displayTitle
          if item.sections
            +renderList(item.sections, currentPath + '/')

.chapter-list
  +renderList(chapters)
