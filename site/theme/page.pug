extends layout.pug

block layout_config
  - printable_article = true

block content
  article.page.reading-page(data-page-id=front_matter.id || "")
    include partials/article-header.pug
    include partials/print-source.pug
    .container.reading-content
      include partials/markdown-body.pug
    include partials/article-footer.pug
